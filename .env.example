# Copy to .env for local work. .env is gitignored and must stay that way.
# In production these are set in Render's Environment tab, never in the repo.

PORT=8000
NODE_ENV=development

# Contact form
RESEND_API_KEY=
RECIPIENT_EMAIL=

# Admin dashboard.
#
# Generate all three with: node scripts/hash-password.js
# The password itself is never stored — only the bcrypt hash of it, which
# cannot be reversed. If any of these three is missing the admin routes are
# not mounted at all and the contact form carries on working.
ADMIN_EMAIL=
ADMIN_PASSWORD_HASH=
SESSION_SECRET=

# Posts
# Either set the three parts below and let the server assemble the URI --
# each one is encoded, so a password containing # @ : / ? or % is safe --
# or set MONGODB_URI yourself and it wins.
MONGODB_USER=
MONGODB_PASSWORD=
MONGODB_CLUSTER=cluster0.pfan7vt.mongodb.net
MONGODB_URI=
MONGODB_DB=devash

# Netlify build hook (Site settings -> Build & deploy -> Build hooks).
# Publishing a post asks Netlify for a build, because readers are served
# static files. Without this the post saves but the live site will not change
# until a build runs for some other reason.
NETLIFY_BUILD_HOOK=

# Cloudinary, for signed direct uploads from the dashboard. The browser never
# sees the secret: the server signs one upload at a time and the file goes
# from the browser straight to Cloudinary.
CLOUDINARY_CLOUD_NAME=h9rhdw24
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
